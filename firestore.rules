rules_version = '2';

// Expense Manager — Firestore Security Rules
// Single-employee app: any signed-in user may read/write documents,
// but every write must stamp the record with their own uid, and only
// the owner (matching uid) may update or delete it afterwards.
// If you ever add more than one employee, this already keeps each
// person's records private to themselves.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(resource) {
      return isSignedIn() && resource.data.uid == request.auth.uid;
    }

    function ownsIncomingWrite() {
      return isSignedIn() && request.resource.data.uid == request.auth.uid;
    }

    match /payments/{docId} {
      allow read: if isSignedIn();
      allow create: if ownsIncomingWrite();
      allow update, delete: if isOwner(resource);
    }

    match /expenses/{docId} {
      allow read: if isSignedIn();
      allow create: if ownsIncomingWrite();
      allow update, delete: if isOwner(resource);
    }

    match /vouchers/{docId} {
      allow read: if isSignedIn();
      allow create: if ownsIncomingWrite();
      allow update, delete: if isOwner(resource);
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
